<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/editor_bg">

    <!-- Barra superior: fila 1 = ← · título · deshacer/rehacer · ⚙ configuración
                          fila 2 = herramientas (desplazable) · guardar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="6dp"
                android:background="@null"
                android:contentDescription="Volver"
                android:src="@drawable/ic_back"
                app:tint="#1A1A1A" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="168dp"
                android:background="@drawable/bg_pill_title_pink"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:text="diario"
                android:textColor="#1A1A1A"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="58dp"
                android:background="@drawable/bg_pill_white_soft"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="5dp">

                <ImageButton
                    android:id="@+id/btn_undo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_undo_on"
                    android:contentDescription="Deshacer"
                    android:padding="7dp"
                    android:src="@drawable/ic_undo"
                    app:tint="#1A1A1A" />

                <ImageButton
                    android:id="@+id/btn_redo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_undo_off"
                    android:contentDescription="Rehacer"
                    android:padding="7dp"
                    android:src="@drawable/ic_redo"
                    app:tint="#1A1A1A" />
            </LinearLayout>

            <!-- ⚙ CONFIGURACIÓN: botón aparte (nueva página, duplicar, PDF, exportar, tipografía…) -->
            <ImageButton
                android:id="@+id/btn_more"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="Configuración"
                android:src="@drawable/ic_more"
                app:tint="#3A3540" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="8dp">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tool_row"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ImageButton
                android:id="@+id/btn_save"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="Guardar"
                android:padding="10dp"
                android:src="@drawable/ic_save" />
        </LinearLayout>
    </LinearLayout>

    <!-- Lienzo -->
    <com.knotes.app.canvas.CanvasPageView
        android:id="@+id/canvas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/pen_bar"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <!-- Botón flotante (lápiz/última herramienta) -->
    <ImageButton
        android:id="@+id/btn_float_pen"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_circle_pink"
        android:src="@drawable/ic_pen"
        app:tint="@color/text_chip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.55"
        android:contentDescription="Lápiz rápido" />

    <!-- Barra de escritura INLINE (T del diario): escribe y sigue las líneas -->
    <LinearLayout
        android:id="@+id/text_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_white"
        android:elevation="10dp"
        android:layout_margin="10dp"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/pen_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/text_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Escribe aquí… seguirá las líneas del papel"
            android:textColor="#2B2B2B"
            android:textColorHint="#9A9288"
            android:textSize="15sp"
            android:maxLines="6"
            android:gravity="top"
            android:scrollbars="vertical"
            android:inputType="textMultiLine"
            android:background="@drawable/bg_cell_white"
            android:padding="10dp" />

        <ImageButton
            android:id="@+id/text_cancel"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@null"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#8A8378" />

        <ImageButton
            android:id="@+id/text_done"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_circle_white"
            android:src="@drawable/ic_save"
            app:tint="#4CAF50" />
    </LinearLayout>

    <!-- Indicador de página -->
    <LinearLayout
        android:id="@+id/page_indicator"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_pill_white"
        android:elevation="6dp"
        android:layout_margin="12dp"
        app:layout_constraintBottom_toTopOf="@id/pen_bar"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_prev_page"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@null"
            android:src="@android:drawable/ic_media_previous"
            app:tint="?attr/kAccentDeep"
            android:contentDescription="Página anterior" />

        <TextView
            android:id="@+id/page_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/1"
            android:textColor="@color/text_chip"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingHorizontal="4dp" />

        <ImageButton
            android:id="@+id/btn_next_page"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@null"
            android:src="@android:drawable/ic_media_next"
            app:tint="?attr/kAccentDeep"
            android:contentDescription="Página siguiente" />

        <ImageButton
            android:id="@+id/btn_quick_page"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:background="@null"
            android:src="@drawable/ic_add"
            app:tint="#4CAF50"
            android:contentDescription="Nueva página con el estilo en uso" />
    </LinearLayout>

    <!-- Popup de selección -->
    <LinearLayout
        android:id="@+id/selection_popup"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_pill_white"
        android:elevation="8dp"
        android:visibility="gone"
        android:paddingHorizontal="10dp"
        app:layout_constraintBottom_toTopOf="@id/pen_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="18dp">

        <ImageButton
            android:id="@+id/sel_rot_l"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@null"
            android:src="@drawable/ic_rot_ccw"
            app:tint="#B26AA6"
            android:contentDescription="Girar a la izquierda" />

        <ImageButton
            android:id="@+id/sel_rot_r"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@null"
            android:src="@drawable/ic_rot_cw"
            app:tint="#4A90D9"
            android:contentDescription="Girar a la derecha" />

        <ImageButton
            android:id="@+id/sel_shrink"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@null"
            android:src="@drawable/ic_minus"
            app:tint="#6E5D66"
            android:contentDescription="Achicar" />

        <ImageButton
            android:id="@+id/sel_grow"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@null"
            android:src="@drawable/ic_add"
            app:tint="#4A90D9"
            android:contentDescription="Agrandar" />

        <ImageButton
            android:id="@+id/sel_delete"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@null"
            android:src="@drawable/ic_trash"
            app:tint="#EE5F8B"
            android:contentDescription="Eliminar selección" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="7dp"
            android:text="Mueve · agranda · gira"
            android:textColor="#9A9288"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/sel_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@null"
            android:src="@drawable/ic_close"
            app:tint="@color/text_chip"
            android:contentDescription="Cerrar selección" />
    </LinearLayout>

    <!-- BARRA DE ESCRITURA FIJA (captura): punta azul + «Alejar» arriba ·
         bandeja de plumas · goma · 5 grosores · 4 colores + paleta -->
    <LinearLayout
        android:id="@+id/pen_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pen_bar"
        android:elevation="14dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="34dp">

            <ImageButton
                android:id="@+id/btn_nib"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_pen_touch"
                android:contentDescription="Herramientas"
                android:padding="5dp"
                android:src="@drawable/ic_nib_blue" />

            <TextView
                android:id="@+id/chip_zoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_chip_outline_pink"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:text="Acercar"
                android:textColor="?attr/kAccentText"
                android:textSize="13sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pen_tray">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/bar_pens"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingHorizontal="6dp" />
                </HorizontalScrollView>
            </FrameLayout>

            <ImageButton
                android:id="@+id/btn_eraser_bar"
                android:layout_width="44dp"
                android:layout_height="68dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pen_touch"
                android:contentDescription="Goma"
                android:scaleType="fitEnd"
                android:src="@drawable/ic_p_eraser" />

            <View
                android:layout_width="1dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="8dp"
                android:background="#3A3A3A" />

            <!-- ZONA FIJA: 5 grosores + 4 colores rápidos + paleta -->
            <LinearLayout
                android:id="@+id/bar_fixed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:id="@+id/bar_sizes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/bar_colors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
